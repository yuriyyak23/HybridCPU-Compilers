<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableBridgeHwirLegacyFixtures Condition="'$(EnableBridgeHwirLegacyFixtures)' == ''">false</EnableBridgeHwirLegacyFixtures>
    <DefineConstants Condition="'$(EnableBridgeHwirLegacyFixtures)' == 'true'">$(DefineConstants);HARDWAREBRIDGE_HWIR</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableBridgeHwirLegacyFixtures)' == 'true'">
    <Compile Include="BridgeHwirAddWordCompiler.cs" />
    <Compile Include="BridgeHwirModelInventory.cs" />
    <Compile Include="BridgeHwirWordDispatch.cs" />
    <Compile Include="BridgeHwirSchedulerCounterCall.cs" />
    <Compile Include="BridgeHwirSchedulerCycleCounter.cs" />
    <Compile Include="BridgeHwirSchedulerTdmPhase.cs" />
    <Compile Include="BridgeHwirRawSlot.cs" />
    <Compile Include="BridgeHwirOpcodeLookup.cs" />
    <Compile Include="BridgeHwirSlotClassMask.cs" />
    <Compile Include="BridgeHwirTypedSlotFacts.cs" />
    <Compile Include="BridgeHwirIssuePacketLaneResolution.cs" />
    <Compile Include="BridgeHwirIssuePacketCreateAllocation.cs" />
    <Compile Include="BridgeHwirIssuePacketMaterializationEligibility.cs" />
    <Compile Include="BridgeHwirIssuePacketMaterializationComposition.cs" />
    <Compile Include="BridgeHwirConsumedDecodedBundleSlotMask.cs" />
    <Compile Include="BridgeHwirIssuePacketNonScalarPhysicalLaneMask.cs" />
    <Compile Include="BridgeHwirLaneChooser.cs" />
    <Compile Include="BridgeHwirLaneMaterialization.cs" />
    <Compile Include="BridgeHwirPacketOwnerPartialGrant.cs" />
    <Compile Include="BridgeHwirCoarseMemoryConflict.cs" />
    <Compile Include="BridgeHwirSingleLaneStoreAdmission.cs" />
    <Compile Include="BridgeHwirLegacyDeferredStorePrevalidation.cs" />
    <Compile Include="BridgeHwirSelectedStoreRevalidation.cs" />
    <Compile Include="BridgeHwirClassAdmission.cs" />
    <Compile Include="BridgeHwirClassCapacity.cs" />
    <Compile Include="BridgeHwirAdmissionDecision.cs" />
    <Compile Include="BridgeHwirTwoCandidateAdmission.cs" />
    <Compile Include="BridgeHwirPressureOrder.cs" />
    <Compile Include="BridgeHwirBankPressure.cs" />
    <Compile Include="BridgeHwirCandidateCollection.cs" />
    <Compile Include="BridgeHwirSmtRanking.cs" />
    <Compile Include="BridgeHwirSmtAssistRankReachability.cs" />
    <Compile Include="BridgeHwirAssistQuota.cs" />
    <Compile Include="BridgeHwirAssistAttemptChain.cs" />
    <Compile Include="BridgeHwirAssistCandidateAttempt.cs" />
    <Compile Include="BridgeHwirAssistRankedCandidateChain.cs" />
    <Compile Include="BridgeHwirSmtLegalityGuardPlane.cs" />
    <Compile Include="BridgeHwirSmtCertificatePredicate.cs" />
    <Compile Include="BridgeHwirSmtOuterGate.cs" />
    <Compile Include="BridgeHwirSmtDuplicateRetry.cs" />
    <Compile Include="BridgeHwirProjectedMemoryState.cs" />
    <Compile Include="BridgeHwirFairnessUpdate.cs" />
    <Compile Include="BridgeHwirOrderedAdmission.cs" />
    <Compile Include="BridgeHwirExplicitScalarLoadLogicalEvent.cs" />
    <Compile Include="BridgeHwirSharedScalarReadLogicalEvent.cs" />
    <Compile Include="BridgeHwirPipelineMemoryLogicalEvent.cs" />
    <Compile Include="BridgeHwirPowerControlCsr.cs" />
    <Compile Include="BridgeHwirCsrAccess.cs" />
    <Compile Include="BridgeHwirCsrStorageEvent.cs" />
    <Compile Include="BridgeHwirStageFlowCycleCsr.cs" />
    <Compile Include="BridgeHwirVectorPodCsr.cs" />
    <Compile Include="BridgeHwirVectorRetireCounterClear.cs" />
    <Compile Include="BridgeHwirCsrClearRetirePath.cs" />
    <Compile Include="BridgeHwirTrapEntryProjection.cs" />
    <Compile Include="BridgeHwirPageFaultDeliveryProjection.cs" />
    <Compile Include="BridgeHwirStageAwareFaultWinner.cs" />
    <Compile Include="BridgeHwirFaultWinnerPayloadMux.cs" />
    <Compile Include="BridgeHwirPageFaultDeliveryComposition.cs" />
    <Compile Include="BridgeHwirVmxValidationCurrent.cs" />
    <Compile Include="BridgeHwirVectorSegmentReadAdmission.cs" />
    <!-- Regression-only adapter; caller pins the checked-out Core project explicitly. -->
    <ProjectReference Include="$(CircuitWeaveRepoRoot)/src/CircuitWeave.Frontend.Roslyn/CircuitWeave.Frontend.Roslyn.csproj"
                      Condition="'$(CircuitWeaveRepoRoot)' != '' and '$(CircuitWeaveExpectedHeadSha)' != '' and '$(BridgeExpectedSdkVersion)' != ''" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Standalone source identity only; Core-derived legacy HWIR stays explicitly opt-in. -->
    <Compile Include="..\SourceSnapshot\BridgeSourceSnapshotV1.cs" Link="BridgeSourceSnapshotV1.cs" />
  </ItemGroup>
  <Target Name="ValidatePinnedBridgeHwirFixtures" BeforeTargets="PrepareForBuild"
          Condition="'$(EnableBridgeHwirLegacyFixtures)' == 'true'">
    <Error Condition="'$(CircuitWeaveRepoRoot)' == '' or '$(CircuitWeaveFrontendRoslynProject)' == ''"
           Text="HBINT0101 MissingCoreFrontend: explicit CircuitWeaveRepoRoot and CircuitWeaveFrontendRoslynProject required." />
    <Error Condition="!Exists('$(CircuitWeaveRepoRoot)/.git') or !Exists('$(CircuitWeaveRepoRoot)/src/CircuitWeave.Frontend.Roslyn/CircuitWeave.Frontend.Roslyn.csproj') or !Exists('$(CircuitWeaveFrontendRoslynProject)')"
           Text="HBINT0102 MissingCoreFrontend: a real checked-out Core root and Roslyn project are required." />
    <Error Condition="'$(CircuitWeaveExpectedHeadSha)' == '' or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(CircuitWeaveExpectedHeadSha)', '^[0-9a-f]{40}$'))"
           Text="HBINT0103 InvalidCorePin: provide reviewed lowercase 40-hex CircuitWeaveExpectedHeadSha." />
    <Error Condition="'$(BridgeExpectedSdkVersion)' == '' or '$(NETCoreSdkVersion)' != '$(BridgeExpectedSdkVersion)'"
           Text="HBINT0104 WrongSdk: BridgeExpectedSdkVersion must match executing NETCoreSdkVersion." />
    <PropertyGroup Condition="'$(CircuitWeaveRepoRoot)' != '' and '$(CircuitWeaveFrontendRoslynProject)' != ''">
      <_HbExpectedFrontend>$([System.IO.Path]::GetFullPath('$(CircuitWeaveRepoRoot)/src/CircuitWeave.Frontend.Roslyn/CircuitWeave.Frontend.Roslyn.csproj'))</_HbExpectedFrontend>
      <_HbActualFrontend>$([System.IO.Path]::GetFullPath('$(CircuitWeaveFrontendRoslynProject)'))</_HbActualFrontend>
    </PropertyGroup>
    <Error Condition="'$(_HbExpectedFrontend)' != '$(_HbActualFrontend)'"
           Text="HBINT0105 WrongCoreProject: frontend must belong to pinned Core root." />
    <Exec Command="git -C &quot;$(CircuitWeaveRepoRoot)&quot; rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_HbCoreCommit" />
    </Exec>
    <Error Condition="'@(_HbCoreCommit)' != '$(CircuitWeaveExpectedHeadSha)'"
           Text="HBINT0103 WrongCoreRevision: Core git HEAD differs from independently reviewed pin." />
    <Exec Command="git -C &quot;$(CircuitWeaveRepoRoot)&quot; status --porcelain --untracked-files=all" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_HbCoreDirty" />
    </Exec>
    <Error Condition="'@(_HbCoreDirty)' != ''"
           Text="HBINT0103 DirtyCoreCheckout: HEAD alone cannot identify modified or untracked Core source." />
  </Target>
</Project>
