<!-- Intermediate output is outside the parent compiler source glob and inside the authorized Studio workspace. -->
<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\..\CircuitWeave-Studio-main\eng\HardwareBridgeBuild\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\..\CircuitWeave-Studio-main\eng\HardwareBridgeBuild\bin\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>
</Project>
