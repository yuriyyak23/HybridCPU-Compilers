  hw.module @smt_candidate_admission_projection(in %current_injections : i32, in %donor_mask : i8, in %is_assist : i1, in %legality_allowed : i1, in %occupancy : i8, in %occupied0 : i8, in %occupied1 : i8, in %occupied2 : i8, in %occupied3 : i8, in %occupied4 : i8, in %occupied5 : i8, in %opportunistic : i1, in %outer_allowed : i1, in %outer_reason : i8, in %permitted_lanes : i8, in %pinned_lane : i8, in %pinning_kind : i8, in %previous_lane : i32, in %replay_active : i1, in %slot_class : i8, in %stable_donor : i1, in %template_hit : i1, in %template_remaining : i8, in %total0 : i8, in %total1 : i8, in %total2 : i8, in %total3 : i8, in %total4 : i8, in %total5 : i8, out accepted : i1, out defined : i1, out fast_consumed : i1, out legality_evaluated : i1, out next_occupancy : i8, out next_occupied0 : i8, out next_occupied1 : i8, out next_occupied2 : i8, out next_occupied3 : i8, out next_occupied4 : i8, out next_occupied5 : i8, out outer_evaluated : i1, out reject_reason : i8, out selected_lane : i3, out stage_b_evaluated : i1, out template_next : i8) {
    %stage_a_result_accepted, %stage_a_result_fast_consumed, %stage_a_result_legality_evaluated, %stage_a_result_outer_evaluated, %stage_a_result_reject_reason, %stage_a_result_template_next = hw.instance "stage_a" @stage_a_capacity_projection(current_injections: %current_injections: i32, is_assist: %is_assist: i1, legality_allowed: %legality_allowed: i1, occupied0: %occupied0: i8, occupied1: %occupied1: i8, occupied2: %occupied2: i8, occupied3: %occupied3: i8, occupied4: %occupied4: i8, occupied5: %occupied5: i8, outer_allowed: %outer_allowed: i1, outer_reason: %outer_reason: i8, slot_class: %slot_class: i8, template_hit: %template_hit: i1, template_remaining: %template_remaining: i8, total0: %total0: i8, total1: %total1: i8, total2: %total2: i8, total3: %total3: i8, total4: %total4: i8, total5: %total5: i8) -> (accepted: i1, fast_consumed: i1, legality_evaluated: i1, outer_evaluated: i1, reject_reason: i8, template_next: i8)
    %stage_b_result_accepted, %stage_b_result_defined, %stage_b_result_reject_reason, %stage_b_result_selected_lane = hw.instance "stage_b" @stage_b_lane_materialization_projection(donor_mask: %donor_mask: i8, occupancy: %occupancy: i8, opportunistic: %opportunistic: i1, permitted_lanes: %permitted_lanes: i8, pinned_lane: %pinned_lane: i8, pinning_kind: %pinning_kind: i8, previous_lane: %previous_lane: i32, replay_active: %replay_active: i1, slot_class: %slot_class: i8, stable_donor: %stable_donor: i1) -> (accepted: i1, defined: i1, reject_reason: i4, selected_lane: i3)
    %accepted_result = comb.and bin %stage_a_result_accepted, %stage_b_result_accepted : i1
    %one1 = hw.constant 1 : i1
    %defined_result = comb.mux bin %stage_a_result_accepted, %stage_b_result_defined, %one1 : i1
    %commit_lane7_id = hw.constant 7 : i3
    %commit_lane7_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane7_id : i3
    %commit_lane7_mask = hw.constant 128 : i8
    %commit_lane6_id = hw.constant 6 : i3
    %commit_lane6_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane6_id : i3
    %commit_lane6_mask = hw.constant 64 : i8
    %commit_lane5_id = hw.constant 5 : i3
    %commit_lane5_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane5_id : i3
    %commit_lane5_mask = hw.constant 32 : i8
    %commit_lane4_id = hw.constant 4 : i3
    %commit_lane4_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane4_id : i3
    %commit_lane4_mask = hw.constant 16 : i8
    %commit_lane3_id = hw.constant 3 : i3
    %commit_lane3_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane3_id : i3
    %commit_lane3_mask = hw.constant 8 : i8
    %commit_lane2_id = hw.constant 2 : i3
    %commit_lane2_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane2_id : i3
    %commit_lane2_mask = hw.constant 4 : i8
    %commit_lane1_id = hw.constant 1 : i3
    %commit_lane1_match = comb.icmp bin eq %stage_b_result_selected_lane, %commit_lane1_id : i3
    %commit_lane1_mask = hw.constant 2 : i8
