  hw.module @stage_a_capacity_projection(in %current_injections : i32, in %is_assist : i1, in %legality_allowed : i1, in %occupied0 : i8, in %occupied1 : i8, in %occupied2 : i8, in %occupied3 : i8, in %occupied4 : i8, in %occupied5 : i8, in %outer_allowed : i1, in %outer_reason : i8, in %slot_class : i8, in %template_hit : i1, in %template_remaining : i8, in %total0 : i8, in %total1 : i8, in %total2 : i8, in %total3 : i8, in %total4 : i8, in %total5 : i8, out accepted : i1, out fast_consumed : i1, out legality_evaluated : i1, out outer_evaluated : i1, out reject_reason : i8, out template_next : i8) {
    %capacity_result_free = hw.instance "capacity" @class_capacity_projection(occupied0: %occupied0: i8, occupied1: %occupied1: i8, occupied2: %occupied2: i8, occupied3: %occupied3: i8, occupied4: %occupied4: i8, occupied5: %occupied5: i8, slot_class: %slot_class: i8, total0: %total0: i8, total1: %total1: i8, total2: %total2: i8, total3: %total3: i8, total4: %total4: i8, total5: %total5: i8) -> (free: i1)
    %control_result_accepted, %control_result_fast_consumed, %control_result_legality_evaluated, %control_result_outer_evaluated, %control_result_reject_reason, %control_result_template_next = hw.instance "control" @stage_a_control_projection(capacity_free: %capacity_result_free: i1, current_injections: %current_injections: i32, is_assist: %is_assist: i1, legality_allowed: %legality_allowed: i1, outer_allowed: %outer_allowed: i1, outer_reason: %outer_reason: i8, slot_class: %slot_class: i8, template_hit: %template_hit: i1, template_remaining: %template_remaining: i8) -> (accepted: i1, fast_consumed: i1, legality_evaluated: i1, outer_evaluated: i1, reject_reason: i8, template_next: i8)
    hw.output %control_result_accepted, %control_result_fast_consumed, %control_result_legality_evaluated, %control_result_outer_evaluated, %control_result_reject_reason, %control_result_template_next : i1, i1, i1, i1, i8, i8
  }
  hw.module @stage_a_control_projection(in %capacity_free : i1, in %current_injections : i32, in %is_assist : i1, in %legality_allowed : i1, in %outer_allowed : i1, in %outer_reason : i8, in %slot_class : i8, in %template_hit : i1, in %template_remaining : i8, out accepted : i1, out fast_consumed : i1, out legality_evaluated : i1, out outer_evaluated : i1, out reject_reason : i8, out template_next : i8) {
    %unclassified8 = hw.constant 7 : i8
    %unclassified = comb.icmp bin eq %slot_class, %unclassified8 : i8
    %one1 = hw.constant 1 : i1
    %classified = comb.xor bin %unclassified, %one1 : i1
    %zero8 = hw.constant 0 : i8
    %empty_budget = comb.icmp bin eq %template_remaining, %zero8 : i8
    %budget_available = comb.xor bin %empty_budget, %one1 : i1
    %hit_budget = comb.and bin %template_hit, %budget_available : i1
    %consume = comb.and bin %classified, %hit_budget : i1
    %capacity_or_fast = comb.or bin %capacity_free, %consume : i1
    %capacity_pass = comb.or bin %unclassified, %capacity_or_fast : i1
    %legality_pass = comb.and bin %capacity_pass, %legality_allowed : i1
    %not_assist = comb.xor bin %is_assist, %one1 : i1
    %outer_eval = comb.and bin %legality_pass, %not_assist : i1
    %outer_denied = comb.xor bin %outer_allowed, %one1 : i1
    %outer_fail = comb.and bin %outer_eval, %outer_denied : i1
    %not_outer_fail = comb.xor bin %outer_fail, %one1 : i1
    %accepted_result = comb.and bin %legality_pass, %not_outer_fail : i1
    %capacity_fail = comb.xor bin %capacity_pass, %one1 : i1
    %zero32 = hw.constant 0 : i32
    %initial_pass = comb.icmp bin eq %current_injections, %zero32 : i32
    %one8 = hw.constant 1 : i8
    %two8 = hw.constant 2 : i8
    %capacity_reason = comb.mux bin %initial_pass, %one8, %two8 : i8
    %illegal = comb.xor bin %legality_allowed, %one1 : i1
    %three8 = hw.constant 3 : i8
    %outer_or_zero = comb.mux bin %outer_fail, %outer_reason, %zero8 : i8
    %legality_reason = comb.mux bin %illegal, %three8, %outer_or_zero : i8
    %reason = comb.mux bin %capacity_fail, %capacity_reason, %legality_reason : i8
    %budget_decrement = comb.sub bin %template_remaining, %one8 : i8
    %budget_result = comb.mux bin %consume, %budget_decrement, %template_remaining : i8
    hw.output %accepted_result, %consume, %capacity_pass, %outer_eval, %reason, %budget_result : i1, i1, i1, i1, i8, i8
  }
  hw.module @stage_b_lane_materialization_projection(in %donor_mask : i8, in %occupancy : i8, in %opportunistic : i1, in %permitted_lanes : i8, in %pinned_lane : i8, in %pinning_kind : i8, in %previous_lane : i32, in %replay_active : i1, in %slot_class : i8, in %stable_donor : i1, out accepted : i1, out defined : i1, out reject_reason : i4, out selected_lane : i3) {
    %one8 = hw.constant 1 : i8
    %hard = comb.icmp bin eq %pinning_kind, %one8 : i8
    %zero1 = hw.constant 0 : i1
    %pin0_byte = hw.constant 0 : i8
    %pin0_match = comb.icmp bin eq %pinned_lane, %pin0_byte : i8
    %all8 = hw.constant 255 : i8
    %not_occupancy = comb.xor bin %occupancy, %all8 : i8
    %pin0_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin0_mask = hw.constant 1 : i8
    %pin0_free_bit = comb.and bin %pin0_free_mask, %pin0_mask : i8
    %zero8 = hw.constant 0 : i8
    %pin0_clear = comb.icmp bin eq %pin0_free_bit, %zero8 : i8
    %one1 = hw.constant 1 : i1
    %pin0_free = comb.xor bin %pin0_clear, %one1 : i1
    %pin0_available = comb.and bin %pin0_match, %pin0_free : i1
    %pin0_available_or = comb.or bin %zero1, %pin0_available : i1
    %pin1_byte = hw.constant 1 : i8
    %pin1_match = comb.icmp bin eq %pinned_lane, %pin1_byte : i8
    %pin1_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin1_mask = hw.constant 2 : i8
    %pin1_free_bit = comb.and bin %pin1_free_mask, %pin1_mask : i8
    %pin1_clear = comb.icmp bin eq %pin1_free_bit, %zero8 : i8
    %pin1_free = comb.xor bin %pin1_clear, %one1 : i1
    %pin1_available = comb.and bin %pin1_match, %pin1_free : i1
    %pin1_available_or = comb.or bin %pin0_available_or, %pin1_available : i1
    %pin2_byte = hw.constant 2 : i8
    %pin2_match = comb.icmp bin eq %pinned_lane, %pin2_byte : i8
    %pin2_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin2_mask = hw.constant 4 : i8
    %pin2_free_bit = comb.and bin %pin2_free_mask, %pin2_mask : i8
    %pin2_clear = comb.icmp bin eq %pin2_free_bit, %zero8 : i8
    %pin2_free = comb.xor bin %pin2_clear, %one1 : i1
    %pin2_available = comb.and bin %pin2_match, %pin2_free : i1
    %pin2_available_or = comb.or bin %pin1_available_or, %pin2_available : i1
    %pin3_byte = hw.constant 3 : i8
    %pin3_match = comb.icmp bin eq %pinned_lane, %pin3_byte : i8
    %pin3_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin3_mask = hw.constant 8 : i8
    %pin3_free_bit = comb.and bin %pin3_free_mask, %pin3_mask : i8
    %pin3_clear = comb.icmp bin eq %pin3_free_bit, %zero8 : i8
    %pin3_free = comb.xor bin %pin3_clear, %one1 : i1
    %pin3_available = comb.and bin %pin3_match, %pin3_free : i1
    %pin3_available_or = comb.or bin %pin2_available_or, %pin3_available : i1
    %pin4_byte = hw.constant 4 : i8
    %pin4_match = comb.icmp bin eq %pinned_lane, %pin4_byte : i8
    %pin4_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin4_mask = hw.constant 16 : i8
    %pin4_free_bit = comb.and bin %pin4_free_mask, %pin4_mask : i8
    %pin4_clear = comb.icmp bin eq %pin4_free_bit, %zero8 : i8
    %pin4_free = comb.xor bin %pin4_clear, %one1 : i1
    %pin4_available = comb.and bin %pin4_match, %pin4_free : i1
    %pin4_available_or = comb.or bin %pin3_available_or, %pin4_available : i1
    %pin5_byte = hw.constant 5 : i8
    %pin5_match = comb.icmp bin eq %pinned_lane, %pin5_byte : i8
    %pin5_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin5_mask = hw.constant 32 : i8
    %pin5_free_bit = comb.and bin %pin5_free_mask, %pin5_mask : i8
    %pin5_clear = comb.icmp bin eq %pin5_free_bit, %zero8 : i8
    %pin5_free = comb.xor bin %pin5_clear, %one1 : i1
    %pin5_available = comb.and bin %pin5_match, %pin5_free : i1
    %pin5_available_or = comb.or bin %pin4_available_or, %pin5_available : i1
    %pin6_byte = hw.constant 6 : i8
    %pin6_match = comb.icmp bin eq %pinned_lane, %pin6_byte : i8
    %pin6_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin6_mask = hw.constant 64 : i8
    %pin6_free_bit = comb.and bin %pin6_free_mask, %pin6_mask : i8
    %pin6_clear = comb.icmp bin eq %pin6_free_bit, %zero8 : i8
    %pin6_free = comb.xor bin %pin6_clear, %one1 : i1
    %pin6_available = comb.and bin %pin6_match, %pin6_free : i1
    %pin6_available_or = comb.or bin %pin5_available_or, %pin6_available : i1
    %pin7_byte = hw.constant 7 : i8
    %pin7_match = comb.icmp bin eq %pinned_lane, %pin7_byte : i8
    %pin7_free_mask = comb.and bin %not_occupancy, %permitted_lanes : i8
    %pin7_mask = hw.constant 128 : i8
    %pin7_free_bit = comb.and bin %pin7_free_mask, %pin7_mask : i8
    %pin7_clear = comb.icmp bin eq %pin7_free_bit, %zero8 : i8
    %pin7_free = comb.xor bin %pin7_clear, %one1 : i1
    %pin7_available = comb.and bin %pin7_match, %pin7_free : i1
    %pin7_available_or = comb.or bin %pin6_available_or, %pin7_available : i1
    %donor_required = comb.and bin %opportunistic, %stable_donor : i1
    %class_mask_lookup_result_lane_mask, %class_mask_lookup_result_valid = hw.instance "class_mask_lookup" @slot_class_mask_projection(slot_class: %slot_class: i8) -> (lane_mask: i8, valid: i1)
    %class_free = comb.and bin %class_mask_lookup_result_lane_mask, %not_occupancy : i8
    %permitted_free = comb.and bin %class_free, %permitted_lanes : i8
    %donor_free = comb.and bin %permitted_free, %donor_mask : i8
    %free_lanes = comb.mux bin %donor_required, %donor_free, %permitted_free : i8
    %lane_chooser_result_reused, %lane_chooser_result_selected_lane, %lane_chooser_result_valid = hw.instance "lane_chooser" @replay_lane_chooser_projection(free_lanes: %free_lanes: i8, previous_lane: %previous_lane: i32, replay_active: %replay_active: i1) -> (reused: i1, selected_lane: i3, valid: i1)
    %accepted_result = comb.mux bin %hard, %pin7_available_or, %lane_chooser_result_valid : i1
    %defined_result = comb.mux bin %hard, %one1, %class_mask_lookup_result_valid : i1
    %pin0_valid_or = comb.or bin %zero1, %pin0_match : i1
    %pin1_valid_or = comb.or bin %pin0_valid_or, %pin1_match : i1
    %pin2_valid_or = comb.or bin %pin1_valid_or, %pin2_match : i1
    %pin3_valid_or = comb.or bin %pin2_valid_or, %pin3_match : i1
    %pin4_valid_or = comb.or bin %pin3_valid_or, %pin4_match : i1
    %pin5_valid_or = comb.or bin %pin4_valid_or, %pin5_match : i1
    %pin6_valid_or = comb.or bin %pin5_valid_or, %pin6_match : i1
    %pin7_valid_or = comb.or bin %pin6_valid_or, %pin7_match : i1
    %zero4 = hw.constant 0 : i4
    %conflict4 = hw.constant 11 : i4
    %pin_conflict_reason = comb.mux bin %pin7_available_or, %zero4, %conflict4 : i4
    %invalid4 = hw.constant 13 : i4
    %pin_reason = comb.mux bin %pin7_valid_or, %pin_conflict_reason, %invalid4 : i4
    %late4 = hw.constant 12 : i4
    %flex_reason = comb.mux bin %lane_chooser_result_valid, %zero4, %late4 : i4
    %reason_result = comb.mux bin %hard, %pin_reason, %flex_reason : i4
    %pin7_id = hw.constant 7 : i3
    %pin6_id = hw.constant 6 : i3
    %pin5_id = hw.constant 5 : i3
    %pin4_id = hw.constant 4 : i3
    %pin3_id = hw.constant 3 : i3
    %pin2_id = hw.constant 2 : i3
    %pin1_id = hw.constant 1 : i3
    %pin0_id = hw.constant 0 : i3
    %zero3 = hw.constant 0 : i3
    %pin0_lane = comb.mux bin %pin0_match, %pin0_id, %zero3 : i3
    %pin1_lane = comb.mux bin %pin1_match, %pin1_id, %pin0_lane : i3
    %pin2_lane = comb.mux bin %pin2_match, %pin2_id, %pin1_lane : i3
    %pin3_lane = comb.mux bin %pin3_match, %pin3_id, %pin2_lane : i3
    %pin4_lane = comb.mux bin %pin4_match, %pin4_id, %pin3_lane : i3
    %pin5_lane = comb.mux bin %pin5_match, %pin5_id, %pin4_lane : i3
    %pin6_lane = comb.mux bin %pin6_match, %pin6_id, %pin5_lane : i3
    %pin7_lane = comb.mux bin %pin7_match, %pin7_id, %pin6_lane : i3
    %lane_result = comb.mux bin %hard, %pin7_lane, %lane_chooser_result_selected_lane : i3
    hw.output %accepted_result, %defined_result, %reason_result, %lane_result : i1, i1, i4, i3
  }
}
