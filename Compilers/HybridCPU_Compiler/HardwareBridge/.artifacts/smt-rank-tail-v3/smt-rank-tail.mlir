// canonical-hwir-sha256: b3ea7b7feb8ccda784851a0559cf0bef70bb8f944655360f762eb721dffed8d6
module {
  hw.module @smt_rank_tail_consumers_projection(in %credit0 : i32, in %credit1 : i32, in %credit2 : i32, in %credit3 : i32, in %cycle : i64, in %fairness_enabled : i1, in %owner_vt : i32, in %unwritten_tail : i32, in %vt0_present : i1, in %vt0_ready : i1, in %vt1_present : i1, in %vt1_ready : i1, in %vt2_present : i1, in %vt2_ready : i1, in %vt3_present : i1, in %vt3_ready : i1, out assist_rank3_index_oob_if_reached : i1, out main_duplicate_candidate_attempt : i1, out rank3_in_range : i1) {
    %ranking_result_rank0, %ranking_result_rank1, %ranking_result_rank2, %ranking_result_rank3 = hw.instance "ranking" @smt_ranking_projection(credit0: %credit0: i32, credit1: %credit1: i32, credit2: %credit2: i32, credit3: %credit3: i32, cycle: %cycle: i64, fairness_enabled: %fairness_enabled: i1, owner_vt: %owner_vt: i32, unwritten_tail: %unwritten_tail: i32, vt1_ready: %vt1_ready: i1, vt2_ready: %vt2_ready: i1, vt3_ready: %vt3_ready: i1) -> (rank0: i32, rank1: i32, rank2: i32, rank3: i32)
    %tail_rank3_64_fill = hw.constant 0 : i32
    %tail_rank3_64 = comb.concat %tail_rank3_64_fill, %ranking_result_rank3 : i32, i32
    %tail_four = hw.constant 4 : i32
    %tail_four_64_fill = hw.constant 0 : i32
    %tail_four_64 = comb.concat %tail_four_64_fill, %tail_four : i32, i32
    %tail_oob_lt = comb.icmp bin ult %tail_rank3_64, %tail_four_64 : i64
    %tail_one = hw.constant 1 : i1
    %tail_oob_raw = comb.xor bin %tail_oob_lt, %tail_one : i1
    %tail_rank3_owner = comb.icmp bin eq %ranking_result_rank3, %owner_vt : i32
    %tail_not_owner = comb.xor bin %tail_rank3_owner, %tail_one : i1
    %tail_oob = comb.and bin %tail_oob_raw, %tail_not_owner : i1
    %tail_dup_rank0 = comb.icmp bin eq %ranking_result_rank3, %ranking_result_rank0 : i32
    %tail_dup_rank1 = comb.icmp bin eq %ranking_result_rank3, %ranking_result_rank1 : i32
    %tail_dup_rank01 = comb.or bin %tail_dup_rank0, %tail_dup_rank1 : i1
    %tail_dup_rank2 = comb.icmp bin eq %ranking_result_rank3, %ranking_result_rank2 : i32
    %tail_duplicate = comb.or bin %tail_dup_rank01, %tail_dup_rank2 : i1
    %tail_id0 = hw.constant 0 : i32
    %tail_is_id0 = comb.icmp bin eq %ranking_result_rank3, %tail_id0 : i32
    %tail_ready_present0 = comb.and bin %vt0_ready, %vt0_present : i1
    %tail_ready_selected0 = comb.and bin %tail_is_id0, %tail_ready_present0 : i1
    %tail_id1 = hw.constant 1 : i32
    %tail_is_id1 = comb.icmp bin eq %ranking_result_rank3, %tail_id1 : i32
    %tail_ready_present1 = comb.and bin %vt1_ready, %vt1_present : i1
    %tail_ready_selected1 = comb.and bin %tail_is_id1, %tail_ready_present1 : i1
    %tail_ready_selected01 = comb.or bin %tail_ready_selected0, %tail_ready_selected1 : i1
    %tail_id2 = hw.constant 2 : i32
    %tail_is_id2 = comb.icmp bin eq %ranking_result_rank3, %tail_id2 : i32
    %tail_ready_present2 = comb.and bin %vt2_ready, %vt2_present : i1
    %tail_ready_selected2 = comb.and bin %tail_is_id2, %tail_ready_present2 : i1
    %tail_id3 = hw.constant 3 : i32
    %tail_is_id3 = comb.icmp bin eq %ranking_result_rank3, %tail_id3 : i32
    %tail_ready_present3 = comb.and bin %vt3_ready, %vt3_present : i1
    %tail_ready_selected3 = comb.and bin %tail_is_id3, %tail_ready_present3 : i1
    %tail_ready_selected23 = comb.or bin %tail_ready_selected2, %tail_ready_selected3 : i1
    %tail_ready_selected_any = comb.or bin %tail_ready_selected01, %tail_ready_selected23 : i1
    %main_duplicate_attempt = comb.and bin %tail_duplicate, %tail_ready_selected_any : i1
    %tail_range01 = comb.or bin %tail_is_id0, %tail_is_id1 : i1
    %tail_range23 = comb.or bin %tail_is_id2, %tail_is_id3 : i1
    %tail_in_range = comb.or bin %tail_range01, %tail_range23 : i1
    hw.output %tail_oob, %main_duplicate_attempt, %tail_in_range : i1, i1, i1
  }
  hw.module @smt_ranking_projection(in %credit0 : i32, in %credit1 : i32, in %credit2 : i32, in %credit3 : i32, in %cycle : i64, in %fairness_enabled : i1, in %owner_vt : i32, in %unwritten_tail : i32, in %vt1_ready : i1, in %vt2_ready : i1, in %vt3_ready : i1, out rank0 : i32, out rank1 : i32, out rank2 : i32, out rank3 : i32) {
    %id0 = hw.constant 0 : i32
    %owner0 = comb.icmp bin eq %owner_vt, %id0 : i32
    %id1 = hw.constant 1 : i32
    %owner1 = comb.icmp bin eq %owner_vt, %id1 : i32
    %sort01_same_owner = comb.icmp bin eq %owner0, %owner1 : i1
    %sign_flip = hw.constant 2147483648 : i32
    %sort01_ax = comb.xor bin %credit0, %sign_flip : i32
    %sort01_a64_fill = hw.constant 0 : i32
    %sort01_a64 = comb.concat %sort01_a64_fill, %sort01_ax : i32, i32
    %sort01_bx = comb.xor bin %credit1, %sign_flip : i32
    %sort01_b64_fill = hw.constant 0 : i32
    %sort01_b64 = comb.concat %sort01_b64_fill, %sort01_bx : i32, i32
    %sort01_greater = comb.icmp bin ult %sort01_a64, %sort01_b64 : i64
    %sort01_equal = comb.icmp bin eq %credit0, %credit1 : i32
    %sort01_ib64_fill = hw.constant 0 : i32
    %sort01_ib64 = comb.concat %sort01_ib64_fill, %id1 : i32, i32
    %sort01_ia64_fill = hw.constant 0 : i32
    %sort01_ia64 = comb.concat %sort01_ia64_fill, %id0 : i32, i32
    %sort01_id_less = comb.icmp bin ult %sort01_ib64, %sort01_ia64 : i64
    %sort01_tie = comb.and bin %sort01_equal, %sort01_id_less : i1
    %sort01_prefer = comb.or bin %sort01_greater, %sort01_tie : i1
    %sort01_same_prefer = comb.and bin %sort01_same_owner, %sort01_prefer : i1
    %one1 = hw.constant 1 : i1
    %sort01_b_not_owner = comb.xor bin %owner1, %one1 : i1
    %sort01_owner_last = comb.and bin %owner0, %sort01_b_not_owner : i1
    %sort01_swap = comb.or bin %sort01_same_prefer, %sort01_owner_last : i1
    %sort01_ownera = comb.mux bin %sort01_swap, %owner1, %owner0 : i1
    %id2 = hw.constant 2 : i32
    %owner2 = comb.icmp bin eq %owner_vt, %id2 : i32
    %sort02_same_owner = comb.icmp bin eq %sort01_ownera, %owner2 : i1
    %sort01_credita = comb.mux bin %sort01_swap, %credit1, %credit0 : i32
    %sort02_ax = comb.xor bin %sort01_credita, %sign_flip : i32
    %sort02_a64_fill = hw.constant 0 : i32
    %sort02_a64 = comb.concat %sort02_a64_fill, %sort02_ax : i32, i32
    %sort02_bx = comb.xor bin %credit2, %sign_flip : i32
    %sort02_b64_fill = hw.constant 0 : i32
    %sort02_b64 = comb.concat %sort02_b64_fill, %sort02_bx : i32, i32
    %sort02_greater = comb.icmp bin ult %sort02_a64, %sort02_b64 : i64
    %sort02_equal = comb.icmp bin eq %sort01_credita, %credit2 : i32
    %sort02_ib64_fill = hw.constant 0 : i32
    %sort02_ib64 = comb.concat %sort02_ib64_fill, %id2 : i32, i32
    %sort01_ida = comb.mux bin %sort01_swap, %id1, %id0 : i32
    %sort02_ia64_fill = hw.constant 0 : i32
    %sort02_ia64 = comb.concat %sort02_ia64_fill, %sort01_ida : i32, i32
    %sort02_id_less = comb.icmp bin ult %sort02_ib64, %sort02_ia64 : i64
    %sort02_tie = comb.and bin %sort02_equal, %sort02_id_less : i1
    %sort02_prefer = comb.or bin %sort02_greater, %sort02_tie : i1
    %sort02_same_prefer = comb.and bin %sort02_same_owner, %sort02_prefer : i1
    %sort02_b_not_owner = comb.xor bin %owner2, %one1 : i1
    %sort02_owner_last = comb.and bin %sort01_ownera, %sort02_b_not_owner : i1
    %sort02_swap = comb.or bin %sort02_same_prefer, %sort02_owner_last : i1
    %sort02_ownera = comb.mux bin %sort02_swap, %owner2, %sort01_ownera : i1
    %id3 = hw.constant 3 : i32
    %owner3 = comb.icmp bin eq %owner_vt, %id3 : i32
    %sort03_same_owner = comb.icmp bin eq %sort02_ownera, %owner3 : i1
    %sort02_credita = comb.mux bin %sort02_swap, %credit2, %sort01_credita : i32
    %sort03_ax = comb.xor bin %sort02_credita, %sign_flip : i32
    %sort03_a64_fill = hw.constant 0 : i32
    %sort03_a64 = comb.concat %sort03_a64_fill, %sort03_ax : i32, i32
    %sort03_bx = comb.xor bin %credit3, %sign_flip : i32
    %sort03_b64_fill = hw.constant 0 : i32
    %sort03_b64 = comb.concat %sort03_b64_fill, %sort03_bx : i32, i32
    %sort03_greater = comb.icmp bin ult %sort03_a64, %sort03_b64 : i64
    %sort03_equal = comb.icmp bin eq %sort02_credita, %credit3 : i32
    %sort03_ib64_fill = hw.constant 0 : i32
    %sort03_ib64 = comb.concat %sort03_ib64_fill, %id3 : i32, i32
    %sort02_ida = comb.mux bin %sort02_swap, %id2, %sort01_ida : i32
    %sort03_ia64_fill = hw.constant 0 : i32
    %sort03_ia64 = comb.concat %sort03_ia64_fill, %sort02_ida : i32, i32
    %sort03_id_less = comb.icmp bin ult %sort03_ib64, %sort03_ia64 : i64
    %sort03_tie = comb.and bin %sort03_equal, %sort03_id_less : i1
    %sort03_prefer = comb.or bin %sort03_greater, %sort03_tie : i1
    %sort03_same_prefer = comb.and bin %sort03_same_owner, %sort03_prefer : i1
    %sort03_b_not_owner = comb.xor bin %owner3, %one1 : i1
    %sort03_owner_last = comb.and bin %sort02_ownera, %sort03_b_not_owner : i1
    %sort03_swap = comb.or bin %sort03_same_prefer, %sort03_owner_last : i1
    %sort03_ida = comb.mux bin %sort03_swap, %id3, %sort02_ida : i32
    %mask64 = hw.constant 63 : i64
    %cycle_mod = comb.and bin %cycle, %mask64 : i64
    %zero64 = hw.constant 0 : i64
    %cycle_zero = comb.icmp bin eq %cycle_mod, %zero64 : i64
    %ready12 = comb.or bin %vt1_ready, %vt2_ready : i1
    %ready_background = comb.or bin %ready12, %vt3_ready : i1
    %force_tdm = comb.and bin %cycle_zero, %ready_background : i1
    %legacy0 = comb.mux bin %force_tdm, %id1, %id0 : i32
    %selected0 = comb.mux bin %fairness_enabled, %sort03_ida, %legacy0 : i32
    %sort01_ownerb = comb.mux bin %sort01_swap, %owner0, %owner1 : i1
    %sort02_ownerb = comb.mux bin %sort02_swap, %sort01_ownera, %owner2 : i1
    %sort12_same_owner = comb.icmp bin eq %sort01_ownerb, %sort02_ownerb : i1
    %sort01_creditb = comb.mux bin %sort01_swap, %credit0, %credit1 : i32
    %sort12_ax = comb.xor bin %sort01_creditb, %sign_flip : i32
    %sort12_a64_fill = hw.constant 0 : i32
    %sort12_a64 = comb.concat %sort12_a64_fill, %sort12_ax : i32, i32
    %sort02_creditb = comb.mux bin %sort02_swap, %sort01_credita, %credit2 : i32
    %sort12_bx = comb.xor bin %sort02_creditb, %sign_flip : i32
    %sort12_b64_fill = hw.constant 0 : i32
    %sort12_b64 = comb.concat %sort12_b64_fill, %sort12_bx : i32, i32
    %sort12_greater = comb.icmp bin ult %sort12_a64, %sort12_b64 : i64
    %sort12_equal = comb.icmp bin eq %sort01_creditb, %sort02_creditb : i32
    %sort02_idb = comb.mux bin %sort02_swap, %sort01_ida, %id2 : i32
    %sort12_ib64_fill = hw.constant 0 : i32
    %sort12_ib64 = comb.concat %sort12_ib64_fill, %sort02_idb : i32, i32
    %sort01_idb = comb.mux bin %sort01_swap, %id0, %id1 : i32
    %sort12_ia64_fill = hw.constant 0 : i32
    %sort12_ia64 = comb.concat %sort12_ia64_fill, %sort01_idb : i32, i32
    %sort12_id_less = comb.icmp bin ult %sort12_ib64, %sort12_ia64 : i64
    %sort12_tie = comb.and bin %sort12_equal, %sort12_id_less : i1
    %sort12_prefer = comb.or bin %sort12_greater, %sort12_tie : i1
    %sort12_same_prefer = comb.and bin %sort12_same_owner, %sort12_prefer : i1
    %sort12_b_not_owner = comb.xor bin %sort02_ownerb, %one1 : i1
    %sort12_owner_last = comb.and bin %sort01_ownerb, %sort12_b_not_owner : i1
    %sort12_swap = comb.or bin %sort12_same_prefer, %sort12_owner_last : i1
    %sort12_ownera = comb.mux bin %sort12_swap, %sort02_ownerb, %sort01_ownerb : i1
    %sort03_ownerb = comb.mux bin %sort03_swap, %sort02_ownera, %owner3 : i1
    %sort13_same_owner = comb.icmp bin eq %sort12_ownera, %sort03_ownerb : i1
    %sort12_credita = comb.mux bin %sort12_swap, %sort02_creditb, %sort01_creditb : i32
    %sort13_ax = comb.xor bin %sort12_credita, %sign_flip : i32
    %sort13_a64_fill = hw.constant 0 : i32
    %sort13_a64 = comb.concat %sort13_a64_fill, %sort13_ax : i32, i32
    %sort03_creditb = comb.mux bin %sort03_swap, %sort02_credita, %credit3 : i32
    %sort13_bx = comb.xor bin %sort03_creditb, %sign_flip : i32
    %sort13_b64_fill = hw.constant 0 : i32
    %sort13_b64 = comb.concat %sort13_b64_fill, %sort13_bx : i32, i32
    %sort13_greater = comb.icmp bin ult %sort13_a64, %sort13_b64 : i64
    %sort13_equal = comb.icmp bin eq %sort12_credita, %sort03_creditb : i32
    %sort03_idb = comb.mux bin %sort03_swap, %sort02_ida, %id3 : i32
    %sort13_ib64_fill = hw.constant 0 : i32
    %sort13_ib64 = comb.concat %sort13_ib64_fill, %sort03_idb : i32, i32
    %sort12_ida = comb.mux bin %sort12_swap, %sort02_idb, %sort01_idb : i32
    %sort13_ia64_fill = hw.constant 0 : i32
    %sort13_ia64 = comb.concat %sort13_ia64_fill, %sort12_ida : i32, i32
    %sort13_id_less = comb.icmp bin ult %sort13_ib64, %sort13_ia64 : i64
    %sort13_tie = comb.and bin %sort13_equal, %sort13_id_less : i1
    %sort13_prefer = comb.or bin %sort13_greater, %sort13_tie : i1
    %sort13_same_prefer = comb.and bin %sort13_same_owner, %sort13_prefer : i1
    %sort13_b_not_owner = comb.xor bin %sort03_ownerb, %one1 : i1
    %sort13_owner_last = comb.and bin %sort12_ownera, %sort13_b_not_owner : i1
    %sort13_swap = comb.or bin %sort13_same_prefer, %sort13_owner_last : i1
    %sort13_ida = comb.mux bin %sort13_swap, %sort03_idb, %sort12_ida : i32
    %legacy1 = comb.mux bin %force_tdm, %id2, %id1 : i32
    %selected1 = comb.mux bin %fairness_enabled, %sort13_ida, %legacy1 : i32
    %sort12_ownerb = comb.mux bin %sort12_swap, %sort01_ownerb, %sort02_ownerb : i1
    %sort13_ownerb = comb.mux bin %sort13_swap, %sort12_ownera, %sort03_ownerb : i1
    %sort23_same_owner = comb.icmp bin eq %sort12_ownerb, %sort13_ownerb : i1
    %sort12_creditb = comb.mux bin %sort12_swap, %sort01_creditb, %sort02_creditb : i32
    %sort23_ax = comb.xor bin %sort12_creditb, %sign_flip : i32
    %sort23_a64_fill = hw.constant 0 : i32
    %sort23_a64 = comb.concat %sort23_a64_fill, %sort23_ax : i32, i32
    %sort13_creditb = comb.mux bin %sort13_swap, %sort12_credita, %sort03_creditb : i32
    %sort23_bx = comb.xor bin %sort13_creditb, %sign_flip : i32
    %sort23_b64_fill = hw.constant 0 : i32
    %sort23_b64 = comb.concat %sort23_b64_fill, %sort23_bx : i32, i32
    %sort23_greater = comb.icmp bin ult %sort23_a64, %sort23_b64 : i64
    %sort23_equal = comb.icmp bin eq %sort12_creditb, %sort13_creditb : i32
    %sort13_idb = comb.mux bin %sort13_swap, %sort12_ida, %sort03_idb : i32
    %sort23_ib64_fill = hw.constant 0 : i32
    %sort23_ib64 = comb.concat %sort23_ib64_fill, %sort13_idb : i32, i32
    %sort12_idb = comb.mux bin %sort12_swap, %sort01_idb, %sort02_idb : i32
    %sort23_ia64_fill = hw.constant 0 : i32
    %sort23_ia64 = comb.concat %sort23_ia64_fill, %sort12_idb : i32, i32
    %sort23_id_less = comb.icmp bin ult %sort23_ib64, %sort23_ia64 : i64
    %sort23_tie = comb.and bin %sort23_equal, %sort23_id_less : i1
    %sort23_prefer = comb.or bin %sort23_greater, %sort23_tie : i1
    %sort23_same_prefer = comb.and bin %sort23_same_owner, %sort23_prefer : i1
    %sort23_b_not_owner = comb.xor bin %sort13_ownerb, %one1 : i1
    %sort23_owner_last = comb.and bin %sort12_ownerb, %sort23_b_not_owner : i1
    %sort23_swap = comb.or bin %sort23_same_prefer, %sort23_owner_last : i1
    %sort23_ida = comb.mux bin %sort23_swap, %sort13_idb, %sort12_idb : i32
    %legacy2 = comb.mux bin %force_tdm, %id3, %id2 : i32
    %selected2 = comb.mux bin %fairness_enabled, %sort23_ida, %legacy2 : i32
    %owner01 = comb.or bin %owner0, %owner1 : i1
    %owner23 = comb.or bin %owner2, %owner3 : i1
    %owner_found = comb.or bin %owner01, %owner23 : i1
    %sort23_idb = comb.mux bin %sort23_swap, %sort12_idb, %sort13_idb : i32
    %last_rank = comb.mux bin %owner_found, %unwritten_tail, %sort23_idb : i32
    %legacy3 = comb.mux bin %force_tdm, %id0, %id3 : i32
    %selected3 = comb.mux bin %fairness_enabled, %last_rank, %legacy3 : i32
    hw.output %selected0, %selected1, %selected2, %selected3 : i32, i32, i32, i32
  }
}
