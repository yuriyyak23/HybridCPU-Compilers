    %sort01_bx = comb.xor bin %credit1, %sign_flip : i32
    %sort01_b64_fill = hw.constant 0 : i32
    %sort01_b64 = comb.concat %sort01_b64_fill, %sort01_bx : i32, i32
    %sort01_greater = comb.icmp bin ult %sort01_a64, %sort01_b64 : i64
    %sort01_equal = comb.icmp bin eq %credit0, %credit1 : i32
    %sort01_ib64_fill = hw.constant 0 : i32
    %sort01_ib64 = comb.concat %sort01_ib64_fill, %id1 : i32, i32
    %sort01_ia64_fill = hw.constant 0 : i32
    %sort01_ia64 = comb.concat %sort01_ia64_fill, %id0 : i32, i32
    %sort01_id_less = comb.icmp bin ult %sort01_ib64, %sort01_ia64 : i64
    %sort01_tie = comb.and bin %sort01_equal, %sort01_id_less : i1
    %sort01_prefer = comb.or bin %sort01_greater, %sort01_tie : i1
    %sort01_same_prefer = comb.and bin %sort01_same_owner, %sort01_prefer : i1
    %one1 = hw.constant 1 : i1
    %sort01_b_not_owner = comb.xor bin %owner1, %one1 : i1
    %sort01_owner_last = comb.and bin %owner0, %sort01_b_not_owner : i1
    %sort01_swap = comb.or bin %sort01_same_prefer, %sort01_owner_last : i1
    %sort01_ownera = comb.mux bin %sort01_swap, %owner1, %owner0 : i1
    %id2 = hw.constant 2 : i32
