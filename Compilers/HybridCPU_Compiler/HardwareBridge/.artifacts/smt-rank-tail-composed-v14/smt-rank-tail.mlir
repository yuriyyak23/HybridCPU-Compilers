    %sort03_ax = comb.xor bin %sort02_credita, %sign_flip : i32
    %sort03_a64_fill = hw.constant 0 : i32
    %sort03_a64 = comb.concat %sort03_a64_fill, %sort03_ax : i32, i32
    %sort03_bx = comb.xor bin %credit3, %sign_flip : i32
