  hw.module @smt_ranking_projection(in %credit0 : i32, in %credit1 : i32, in %credit2 : i32, in %credit3 : i32, in %cycle : i64, in %fairness_enabled : i1, in %owner_vt : i32, in %unwritten_tail : i32, in %vt1_ready : i1, in %vt2_ready : i1, in %vt3_ready : i1, out rank0 : i32, out rank1 : i32, out rank2 : i32, out rank3 : i32) {
    %id0 = hw.constant 0 : i32
    %owner0 = comb.icmp bin eq %owner_vt, %id0 : i32
    %id1 = hw.constant 1 : i32
    %owner1 = comb.icmp bin eq %owner_vt, %id1 : i32
    %sort01_same_owner = comb.icmp bin eq %owner0, %owner1 : i1
    %sign_flip = hw.constant 2147483648 : i32
    %sort01_ax = comb.xor bin %credit0, %sign_flip : i32
    %sort01_a64_fill = hw.constant 0 : i32
