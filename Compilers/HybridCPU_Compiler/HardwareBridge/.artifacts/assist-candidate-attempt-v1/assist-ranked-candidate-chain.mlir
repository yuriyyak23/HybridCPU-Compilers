    %condition2_hit = comb.mux bin %is_memory, %bank_pending, %zero1 : i1
    %condition3_hit = comb.or bin %bundle_store_bank_pending, %zero1 : i1
    %shared_remaining_zero = comb.icmp bin eq %remaining_memory_issue_budget, %zero8 : i8
    %shared_remaining_ok = comb.xor bin %shared_remaining_zero, %one1 : i1
    %budget_bank64_fill = hw.constant 0 : i32
    %budget_bank64 = comb.concat %budget_bank64_fill, %bank_id : i32, i32
    %sixteen64 = hw.constant 16 : i64
    %budget_bank_valid = comb.icmp bin ult %budget_bank64, %sixteen64 : i64
    %budget_bank_invalid = comb.xor bin %budget_bank_valid, %one1 : i1
    %budget_bank_shift = comb.add bin %bank_id, %bank_id : i32
    %shared_bank_budget_shifted_amount_low = comb.extract %budget_bank_shift from 0 : (i32) -> i5
    %shared_bank_budget_shifted_amount_zero = hw.constant 0 : i27
    %shared_bank_budget_shifted_amount = comb.concat %shared_bank_budget_shifted_amount_zero, %shared_bank_budget_shifted_amount_low : i27, i5
    %shared_bank_budget_shifted = comb.shru bin %consumed_memory_budget_by_bank, %shared_bank_budget_shifted_amount : i32
    %three32 = hw.constant 3 : i32
    %shared_bank_budget_cell = comb.and bin %shared_bank_budget_shifted, %three32 : i32
    %shared_bank_budget_cell64_fill = hw.constant 0 : i32
