    %capacity_vt0_selected_capacity = comb.mux bin %capacity_vt0_match, %projected_capacity_vt0, %zero8 : i8
    %capacity_vt1_selected_capacity = comb.mux bin %capacity_vt1_match, %projected_capacity_vt1, %capacity_vt0_selected_capacity : i8
    %capacity_vt2_selected_capacity = comb.mux bin %capacity_vt2_match, %projected_capacity_vt2, %capacity_vt1_selected_capacity : i8
