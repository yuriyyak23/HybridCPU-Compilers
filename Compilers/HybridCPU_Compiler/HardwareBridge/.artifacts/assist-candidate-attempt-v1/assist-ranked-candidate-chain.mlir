    %shared_bank_two_mask32_fill = hw.constant 0 : i16
    %shared_bank_two_mask32 = comb.concat %shared_bank_two_mask32_fill, %memory_bank_budget_at_least_two_mask : i16, i16
    %shared_bank_two_shifted_amount_low = comb.extract %bank_id from 0 : (i32) -> i5
    %shared_bank_two_shifted_amount_zero = hw.constant 0 : i27
    %shared_bank_two_shifted_amount = comb.concat %shared_bank_two_shifted_amount_zero, %shared_bank_two_shifted_amount_low : i27, i5
    %shared_bank_two_shifted = comb.shru bin %shared_bank_two_mask32, %shared_bank_two_shifted_amount : i32
    %one32 = hw.constant 1 : i32
    %shared_bank_two_bit = comb.and bin %shared_bank_two_shifted, %one32 : i32
    %shared_bank_two_present = comb.icmp bin eq %shared_bank_two_bit, %one32 : i32
    %two8 = hw.constant 2 : i8
