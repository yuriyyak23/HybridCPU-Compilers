    %capacity_vt1_selected_count = comb.mux bin %capacity_vt1_match, %projected_count_vt1, %capacity_vt0_selected_count : i8
    %capacity_vt2_selected_count = comb.mux bin %capacity_vt2_match, %projected_count_vt2, %capacity_vt1_selected_count : i8
    %capacity_vt3_selected_count = comb.mux bin %capacity_vt3_match, %projected_count_vt3, %capacity_vt2_selected_count : i8
    %capacity_count64_fill = hw.constant 0 : i56
