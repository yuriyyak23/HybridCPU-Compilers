    %waw_overlap = comb.and bin %candidate_write32, %bundle_write32 : i32
    %hazard_any = comb.or bin %hazard01, %waw_overlap : i32
    %zero32 = hw.constant 0 : i32
    %register_clear = comb.icmp bin eq %hazard_any, %zero32 : i32
    %register_conflict_value = comb.xor bin %register_clear, %one1 : i1
    %any_conflict = comb.or bin %shared_conflict_value, %register_conflict_value : i1
    %allowed_value = comb.xor bin %any_conflict, %one1 : i1
    %one2 = hw.constant 1 : i2
    %two2 = hw.constant 2 : i2
    %zero2 = hw.constant 0 : i2
    %register_detail = comb.mux bin %register_conflict_value, %two2, %zero2 : i2
    %detail_value = comb.mux bin %shared_conflict_value, %one2, %register_detail : i2
    hw.output %allowed_value, %register_conflict_value, %detail_value, %replay_match, %shared_conflict_value : i1, i1, i2, i1, i1
  }
