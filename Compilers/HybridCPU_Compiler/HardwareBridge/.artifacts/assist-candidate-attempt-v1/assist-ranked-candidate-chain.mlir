    %capacity_vt3_valid = comb.or bin %capacity_vt2_valid, %capacity_vt3_match : i1
    %capacity_invalid_vt = comb.xor bin %capacity_vt3_valid, %one1 : i1
    %zero8 = hw.constant 0 : i8
