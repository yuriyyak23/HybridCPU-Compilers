  hw.module @class_capacity_projection(in %occupied0 : i8, in %occupied1 : i8, in %occupied2 : i8, in %occupied3 : i8, in %occupied4 : i8, in %occupied5 : i8, in %slot_class : i8, in %total0 : i8, in %total1 : i8, in %total2 : i8, in %total3 : i8, in %total4 : i8, in %total5 : i8, out free : i1) {
    %c5_id = hw.constant 5 : i8
    %c5_match = comb.icmp bin eq %slot_class, %c5_id : i8
    %c5_occupied_fill = hw.constant 0 : i56
    %c5_occupied = comb.concat %c5_occupied_fill, %occupied5 : i56, i8
    %c5_alias_fill = hw.constant 0 : i56
    %c5_alias = comb.concat %c5_alias_fill, %occupied2 : i56, i8
    %c5_sum = comb.add bin %c5_occupied, %c5_alias : i64
    %c5_total_fill = hw.constant 0 : i56
    %c5_total = comb.concat %c5_total_fill, %total5 : i56, i8
    %c5_free = comb.icmp bin ult %c5_sum, %c5_total : i64
    %c4_id = hw.constant 4 : i8
    %c4_match = comb.icmp bin eq %slot_class, %c4_id : i8
    %c4_occupied_fill = hw.constant 0 : i56
    %c4_occupied = comb.concat %c4_occupied_fill, %occupied4 : i56, i8
    %c4_alias_fill = hw.constant 0 : i56
    %c4_alias = comb.concat %c4_alias_fill, %occupied3 : i56, i8
    %c4_sum = comb.add bin %c4_occupied, %c4_alias : i64
    %c4_total_fill = hw.constant 0 : i56
    %c4_total = comb.concat %c4_total_fill, %total4 : i56, i8
    %c4_free = comb.icmp bin ult %c4_sum, %c4_total : i64
    %c3_id = hw.constant 3 : i8
    %c3_match = comb.icmp bin eq %slot_class, %c3_id : i8
    %c3_occupied_fill = hw.constant 0 : i56
    %c3_occupied = comb.concat %c3_occupied_fill, %occupied3 : i56, i8
    %c3_alias_fill = hw.constant 0 : i56
    %c3_alias = comb.concat %c3_alias_fill, %occupied4 : i56, i8
    %c3_sum = comb.add bin %c3_occupied, %c3_alias : i64
    %c3_total_fill = hw.constant 0 : i56
    %c3_total = comb.concat %c3_total_fill, %total3 : i56, i8
    %c3_free = comb.icmp bin ult %c3_sum, %c3_total : i64
    %c2_id = hw.constant 2 : i8
    %c2_match = comb.icmp bin eq %slot_class, %c2_id : i8
    %c2_occupied_fill = hw.constant 0 : i56
    %c2_occupied = comb.concat %c2_occupied_fill, %occupied2 : i56, i8
    %c2_alias_fill = hw.constant 0 : i56
    %c2_alias = comb.concat %c2_alias_fill, %occupied5 : i56, i8
    %c2_sum = comb.add bin %c2_occupied, %c2_alias : i64
    %c2_total_fill = hw.constant 0 : i56
    %c2_total = comb.concat %c2_total_fill, %total2 : i56, i8
    %c2_free = comb.icmp bin ult %c2_sum, %c2_total : i64
    %c1_id = hw.constant 1 : i8
    %c1_match = comb.icmp bin eq %slot_class, %c1_id : i8
    %c1_occupied_fill = hw.constant 0 : i56
    %c1_occupied = comb.concat %c1_occupied_fill, %occupied1 : i56, i8
    %c1_total_fill = hw.constant 0 : i56
    %c1_total = comb.concat %c1_total_fill, %total1 : i56, i8
    %c1_free = comb.icmp bin ult %c1_occupied, %c1_total : i64
    %c0_id = hw.constant 0 : i8
    %c0_match = comb.icmp bin eq %slot_class, %c0_id : i8
    %c0_occupied_fill = hw.constant 0 : i56
    %c0_occupied = comb.concat %c0_occupied_fill, %occupied0 : i56, i8
    %c0_total_fill = hw.constant 0 : i56
    %c0_total = comb.concat %c0_total_fill, %total0 : i56, i8
    %c0_free = comb.icmp bin ult %c0_occupied, %c0_total : i64
    %zero1 = hw.constant 0 : i1
    %c0_result = comb.mux bin %c0_match, %c0_free, %zero1 : i1
    %c1_result = comb.mux bin %c1_match, %c1_free, %c0_result : i1
    %c2_result = comb.mux bin %c2_match, %c2_free, %c1_result : i1
    %c3_result = comb.mux bin %c3_match, %c3_free, %c2_result : i1
    %c4_result = comb.mux bin %c4_match, %c4_free, %c3_result : i1
    %c5_result = comb.mux bin %c5_match, %c5_free, %c4_result : i1
    hw.output %c5_result : i1
  }
  hw.module @replay_lane_chooser_projection(in %free_lanes : i8, in %previous_lane : i32, in %replay_active : i1, out reused : i1, out selected_lane : i3, out valid : i1) {
    %lane0_previous = hw.constant 0 : i32
    %lane0_previous_match = comb.icmp bin eq %previous_lane, %lane0_previous : i32
    %lane0_mask = hw.constant 1 : i8
    %lane0_masked = comb.and bin %free_lanes, %lane0_mask : i8
    %zero8 = hw.constant 0 : i8
    %lane0_clear = comb.icmp bin eq %lane0_masked, %zero8 : i8
    %one1 = hw.constant 1 : i1
    %lane0_free = comb.xor bin %lane0_clear, %one1 : i1
    %lane0_hint_free = comb.and bin %lane0_previous_match, %lane0_free : i1
    %lane1_previous = hw.constant 1 : i32
    %lane1_previous_match = comb.icmp bin eq %previous_lane, %lane1_previous : i32
    %lane1_mask = hw.constant 2 : i8
    %lane1_masked = comb.and bin %free_lanes, %lane1_mask : i8
    %lane1_clear = comb.icmp bin eq %lane1_masked, %zero8 : i8
    %lane1_free = comb.xor bin %lane1_clear, %one1 : i1
    %lane1_hint_free = comb.and bin %lane1_previous_match, %lane1_free : i1
    %lane2_previous = hw.constant 2 : i32
    %lane2_previous_match = comb.icmp bin eq %previous_lane, %lane2_previous : i32
    %lane2_mask = hw.constant 4 : i8
    %lane2_masked = comb.and bin %free_lanes, %lane2_mask : i8
    %lane2_clear = comb.icmp bin eq %lane2_masked, %zero8 : i8
    %lane2_free = comb.xor bin %lane2_clear, %one1 : i1
    %lane2_hint_free = comb.and bin %lane2_previous_match, %lane2_free : i1
    %lane3_previous = hw.constant 3 : i32
    %lane3_previous_match = comb.icmp bin eq %previous_lane, %lane3_previous : i32
    %lane3_mask = hw.constant 8 : i8
    %lane3_masked = comb.and bin %free_lanes, %lane3_mask : i8
    %lane3_clear = comb.icmp bin eq %lane3_masked, %zero8 : i8
    %lane3_free = comb.xor bin %lane3_clear, %one1 : i1
    %lane3_hint_free = comb.and bin %lane3_previous_match, %lane3_free : i1
    %lane4_previous = hw.constant 4 : i32
    %lane4_previous_match = comb.icmp bin eq %previous_lane, %lane4_previous : i32
    %lane4_mask = hw.constant 16 : i8
    %lane4_masked = comb.and bin %free_lanes, %lane4_mask : i8
    %lane4_clear = comb.icmp bin eq %lane4_masked, %zero8 : i8
    %lane4_free = comb.xor bin %lane4_clear, %one1 : i1
    %lane4_hint_free = comb.and bin %lane4_previous_match, %lane4_free : i1
    %lane5_previous = hw.constant 5 : i32
    %lane5_previous_match = comb.icmp bin eq %previous_lane, %lane5_previous : i32
    %lane5_mask = hw.constant 32 : i8
    %lane5_masked = comb.and bin %free_lanes, %lane5_mask : i8
    %lane5_clear = comb.icmp bin eq %lane5_masked, %zero8 : i8
    %lane5_free = comb.xor bin %lane5_clear, %one1 : i1
    %lane5_hint_free = comb.and bin %lane5_previous_match, %lane5_free : i1
    %lane6_previous = hw.constant 6 : i32
    %lane6_previous_match = comb.icmp bin eq %previous_lane, %lane6_previous : i32
    %lane6_mask = hw.constant 64 : i8
    %lane6_masked = comb.and bin %free_lanes, %lane6_mask : i8
    %lane6_clear = comb.icmp bin eq %lane6_masked, %zero8 : i8
    %lane6_free = comb.xor bin %lane6_clear, %one1 : i1
    %lane6_hint_free = comb.and bin %lane6_previous_match, %lane6_free : i1
    %lane7_previous = hw.constant 7 : i32
    %lane7_previous_match = comb.icmp bin eq %previous_lane, %lane7_previous : i32
    %lane7_mask = hw.constant 128 : i8
    %lane7_masked = comb.and bin %free_lanes, %lane7_mask : i8
    %lane7_clear = comb.icmp bin eq %lane7_masked, %zero8 : i8
    %lane7_free = comb.xor bin %lane7_clear, %one1 : i1
    %lane7_hint_free = comb.and bin %lane7_previous_match, %lane7_free : i1
    %zero1 = hw.constant 0 : i1
    %lane7_reuse_or = comb.or bin %lane7_hint_free, %zero1 : i1
    %lane6_reuse_or = comb.or bin %lane6_hint_free, %lane7_reuse_or : i1
    %lane5_reuse_or = comb.or bin %lane5_hint_free, %lane6_reuse_or : i1
    %lane4_reuse_or = comb.or bin %lane4_hint_free, %lane5_reuse_or : i1
    %lane3_reuse_or = comb.or bin %lane3_hint_free, %lane4_reuse_or : i1
    %lane2_reuse_or = comb.or bin %lane2_hint_free, %lane3_reuse_or : i1
    %lane1_reuse_or = comb.or bin %lane1_hint_free, %lane2_reuse_or : i1
    %lane0_reuse_or = comb.or bin %lane0_hint_free, %lane1_reuse_or : i1
    %reuse_active = comb.and bin %replay_active, %lane0_reuse_or : i1
    %lane0_id = hw.constant 0 : i3
    %lane1_id = hw.constant 1 : i3
    %lane2_id = hw.constant 2 : i3
    %lane3_id = hw.constant 3 : i3
    %lane4_id = hw.constant 4 : i3
    %lane5_id = hw.constant 5 : i3
    %lane6_id = hw.constant 6 : i3
    %lane7_id = hw.constant 7 : i3
    %zero3 = hw.constant 0 : i3
    %lane7_previous_result = comb.mux bin %lane7_hint_free, %lane7_id, %zero3 : i3
    %lane6_previous_result = comb.mux bin %lane6_hint_free, %lane6_id, %lane7_previous_result : i3
    %lane5_previous_result = comb.mux bin %lane5_hint_free, %lane5_id, %lane6_previous_result : i3
    %lane4_previous_result = comb.mux bin %lane4_hint_free, %lane4_id, %lane5_previous_result : i3
    %lane3_previous_result = comb.mux bin %lane3_hint_free, %lane3_id, %lane4_previous_result : i3
    %lane2_previous_result = comb.mux bin %lane2_hint_free, %lane2_id, %lane3_previous_result : i3
    %lane1_previous_result = comb.mux bin %lane1_hint_free, %lane1_id, %lane2_previous_result : i3
    %lane0_previous_result = comb.mux bin %lane0_hint_free, %lane0_id, %lane1_previous_result : i3
    %lane7_lowest = comb.mux bin %lane7_free, %lane7_id, %zero3 : i3
    %lane6_lowest = comb.mux bin %lane6_free, %lane6_id, %lane7_lowest : i3
    %lane5_lowest = comb.mux bin %lane5_free, %lane5_id, %lane6_lowest : i3
    %lane4_lowest = comb.mux bin %lane4_free, %lane4_id, %lane5_lowest : i3
    %lane3_lowest = comb.mux bin %lane3_free, %lane3_id, %lane4_lowest : i3
    %lane2_lowest = comb.mux bin %lane2_free, %lane2_id, %lane3_lowest : i3
    %lane1_lowest = comb.mux bin %lane1_free, %lane1_id, %lane2_lowest : i3
    %lane0_lowest = comb.mux bin %lane0_free, %lane0_id, %lane1_lowest : i3
    %selected = comb.mux bin %reuse_active, %lane0_previous_result, %lane0_lowest : i3
    %none = comb.icmp bin eq %free_lanes, %zero8 : i8
    %has_lane = comb.xor bin %none, %one1 : i1
    hw.output %reuse_active, %selected, %has_lane : i1, i3, i1
  }
  hw.module @slot_class_mask_projection(in %slot_class : i8, out lane_mask : i8, out valid : i1) {
    %class6_code = hw.constant 7 : i8
    %class6_match = comb.icmp bin eq %slot_class, %class6_code : i8
    %class6_mask = hw.constant 255 : i8
    %class5_code = hw.constant 5 : i8
    %class5_match = comb.icmp bin eq %slot_class, %class5_code : i8
    %class5_mask = hw.constant 64 : i8
    %class4_code = hw.constant 4 : i8
    %class4_match = comb.icmp bin eq %slot_class, %class4_code : i8
    %class4_mask = hw.constant 128 : i8
    %class3_code = hw.constant 3 : i8
    %class3_match = comb.icmp bin eq %slot_class, %class3_code : i8
    %class3_mask = hw.constant 128 : i8
    %class2_code = hw.constant 2 : i8
    %class2_match = comb.icmp bin eq %slot_class, %class2_code : i8
    %class2_mask = hw.constant 64 : i8
    %class1_code = hw.constant 1 : i8
    %class1_match = comb.icmp bin eq %slot_class, %class1_code : i8
    %class1_mask = hw.constant 48 : i8
    %class0_code = hw.constant 0 : i8
    %class0_match = comb.icmp bin eq %slot_class, %class0_code : i8
    %class0_mask = hw.constant 15 : i8
    %zero_mask = hw.constant 0 : i8
    %class0_result = comb.mux bin %class0_match, %class0_mask, %zero_mask : i8
    %class1_result = comb.mux bin %class1_match, %class1_mask, %class0_result : i8
    %class2_result = comb.mux bin %class2_match, %class2_mask, %class1_result : i8
    %class3_result = comb.mux bin %class3_match, %class3_mask, %class2_result : i8
    %class4_result = comb.mux bin %class4_match, %class4_mask, %class3_result : i8
    %class5_result = comb.mux bin %class5_match, %class5_mask, %class4_result : i8
    %class6_result = comb.mux bin %class6_match, %class6_mask, %class5_result : i8
    %valid_bit = hw.constant 1 : i1
    %invalid = hw.constant 0 : i1
    %class0_valid = comb.mux bin %class0_match, %valid_bit, %invalid : i1
    %class1_valid = comb.mux bin %class1_match, %valid_bit, %class0_valid : i1
    %class2_valid = comb.mux bin %class2_match, %valid_bit, %class1_valid : i1
    %class3_valid = comb.mux bin %class3_match, %valid_bit, %class2_valid : i1
    %class4_valid = comb.mux bin %class4_match, %valid_bit, %class3_valid : i1
    %class5_valid = comb.mux bin %class5_match, %valid_bit, %class4_valid : i1
    %class6_valid = comb.mux bin %class6_match, %valid_bit, %class5_valid : i1
    hw.output %class6_result, %class6_valid : i8, i1
  }
  hw.module @smt_bundle_certificate_predicate_projection(in %bundle_shared_high : i64, in %bundle_shared_low : i64, in %bundle_vt0_mask : i32, in %bundle_vt1_mask : i32, in %bundle_vt2_mask : i32, in %bundle_vt3_mask : i32, in %candidate_register_hazard_mask : i32, in %candidate_shared_high : i64, in %candidate_shared_low : i64, in %candidate_virtual_thread_id : i32, in %phase_key_valid : i1, in %phase_shared_high : i64, in %phase_shared_low : i64, in %phase_template_matches : i1, in %phase_vt0_mask : i32, in %phase_vt1_mask : i32, in %phase_vt2_mask : i32, in %phase_vt3_mask : i32, out allowed : i1, out register_conflict : i1, out reject_detail : i2, out replay_certificate_selected : i1, out shared_conflict : i1) {
    %replay_match = comb.and bin %phase_key_valid, %phase_template_matches : i1
    %phase_low_hit = comb.and bin %phase_shared_low, %candidate_shared_low : i64
    %bundle_low_hit = comb.and bin %bundle_shared_low, %candidate_shared_low : i64
    %selected_low_hit = comb.mux bin %replay_match, %phase_low_hit, %bundle_low_hit : i64
    %zero64 = hw.constant 0 : i64
    %selected_low_clear = comb.icmp bin eq %selected_low_hit, %zero64 : i64
    %phase_high_hit = comb.and bin %phase_shared_high, %candidate_shared_high : i64
    %bundle_high_hit = comb.and bin %bundle_shared_high, %candidate_shared_high : i64
    %selected_high_hit = comb.mux bin %replay_match, %phase_high_hit, %bundle_high_hit : i64
    %selected_high_clear = comb.icmp bin eq %selected_high_hit, %zero64 : i64
    %shared_clear = comb.and bin %selected_low_clear, %selected_high_clear : i1
    %one1 = hw.constant 1 : i1
    %shared_conflict_value = comb.xor bin %shared_clear, %one1 : i1
    %readMask32 = hw.constant 65535 : i32
    %candidate_read32 = comb.and bin %candidate_register_hazard_mask, %readMask32 : i32
    %vt_id0 = hw.constant 0 : i32
    %vt_match0 = comb.icmp bin eq %candidate_virtual_thread_id, %vt_id0 : i32
    %vt_id1 = hw.constant 1 : i32
    %vt_match1 = comb.icmp bin eq %candidate_virtual_thread_id, %vt_id1 : i32
    %vt_id2 = hw.constant 2 : i32
    %vt_match2 = comb.icmp bin eq %candidate_virtual_thread_id, %vt_id2 : i32
    %phase_vt_select2 = comb.mux bin %vt_match2, %phase_vt2_mask, %phase_vt3_mask : i32
    %phase_vt_select1 = comb.mux bin %vt_match1, %phase_vt1_mask, %phase_vt_select2 : i32
    %phase_vt_select0 = comb.mux bin %vt_match0, %phase_vt0_mask, %phase_vt_select1 : i32
    %bundle_vt_select2 = comb.mux bin %vt_match2, %bundle_vt2_mask, %bundle_vt3_mask : i32
    %bundle_vt_select1 = comb.mux bin %vt_match1, %bundle_vt1_mask, %bundle_vt_select2 : i32
    %bundle_vt_select0 = comb.mux bin %vt_match0, %bundle_vt0_mask, %bundle_vt_select1 : i32
    %selected_bundle_vt = comb.mux bin %replay_match, %phase_vt_select0, %bundle_vt_select0 : i32
