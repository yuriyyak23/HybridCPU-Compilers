    %shared_bank_one_mask32 = comb.concat %shared_bank_one_mask32_fill, %memory_bank_budget_at_least_one_mask : i16, i16
    %shared_bank_one_shifted_amount_low = comb.extract %bank_id from 0 : (i32) -> i5
    %shared_bank_one_shifted_amount_zero = hw.constant 0 : i27
    %shared_bank_one_shifted_amount = comb.concat %shared_bank_one_shifted_amount_zero, %shared_bank_one_shifted_amount_low : i27, i5
    %shared_bank_one_shifted = comb.shru bin %shared_bank_one_mask32, %shared_bank_one_shifted_amount : i32
    %shared_bank_one_bit = comb.and bin %shared_bank_one_shifted, %one32 : i32
    %shared_bank_one_present = comb.icmp bin eq %shared_bank_one_bit, %one32 : i32
    %one8 = hw.constant 1 : i8
    %shared_bank_at_least_one = comb.mux bin %shared_bank_one_present, %one8, %zero8 : i8
