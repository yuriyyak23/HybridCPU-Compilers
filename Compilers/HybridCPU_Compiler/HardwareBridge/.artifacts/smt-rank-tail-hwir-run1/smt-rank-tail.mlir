    %sort01_creditb = comb.mux bin %sort01_swap, %credit0, %credit1 : i32
    %sort12_ax = comb.xor bin %sort01_creditb, %sign_flip : i32
    %sort12_a64_fill = hw.constant 0 : i32
    %sort12_a64 = comb.concat %sort12_a64_fill, %sort12_ax : i32, i32
    %sort02_creditb = comb.mux bin %sort02_swap, %sort01_credita, %credit2 : i32
    %sort12_bx = comb.xor bin %sort02_creditb, %sign_flip : i32
    %sort12_b64_fill = hw.constant 0 : i32
    %sort12_b64 = comb.concat %sort12_b64_fill, %sort12_bx : i32, i32
    %sort12_greater = comb.icmp bin ult %sort12_a64, %sort12_b64 : i64
    %sort12_equal = comb.icmp bin eq %sort01_creditb, %sort02_creditb : i32
    %sort02_idb = comb.mux bin %sort02_swap, %sort01_ida, %id2 : i32
    %sort12_ib64_fill = hw.constant 0 : i32
    %sort12_ib64 = comb.concat %sort12_ib64_fill, %sort02_idb : i32, i32
    %sort01_idb = comb.mux bin %sort01_swap, %id0, %id1 : i32
    %sort12_ia64_fill = hw.constant 0 : i32
    %sort12_ia64 = comb.concat %sort12_ia64_fill, %sort01_idb : i32, i32
    %sort12_id_less = comb.icmp bin ult %sort12_ib64, %sort12_ia64 : i64
    %sort12_tie = comb.and bin %sort12_equal, %sort12_id_less : i1
    %sort12_prefer = comb.or bin %sort12_greater, %sort12_tie : i1
    %sort12_same_prefer = comb.and bin %sort12_same_owner, %sort12_prefer : i1
    %sort12_b_not_owner = comb.xor bin %sort02_ownerb, %one1 : i1
    %sort12_owner_last = comb.and bin %sort01_ownerb, %sort12_b_not_owner : i1
    %sort12_swap = comb.or bin %sort12_same_prefer, %sort12_owner_last : i1
    %sort12_ownera = comb.mux bin %sort12_swap, %sort02_ownerb, %sort01_ownerb : i1
    %sort03_ownerb = comb.mux bin %sort03_swap, %sort02_ownera, %owner3 : i1
    %sort13_same_owner = comb.icmp bin eq %sort12_ownera, %sort03_ownerb : i1
    %sort12_credita = comb.mux bin %sort12_swap, %sort02_creditb, %sort01_creditb : i32
    %sort13_ax = comb.xor bin %sort12_credita, %sign_flip : i32
    %sort13_a64_fill = hw.constant 0 : i32
    %sort13_a64 = comb.concat %sort13_a64_fill, %sort13_ax : i32, i32
    %sort03_creditb = comb.mux bin %sort03_swap, %sort02_credita, %credit3 : i32
    %sort13_bx = comb.xor bin %sort03_creditb, %sign_flip : i32
    %sort13_b64_fill = hw.constant 0 : i32
    %sort13_b64 = comb.concat %sort13_b64_fill, %sort13_bx : i32, i32
    %sort13_greater = comb.icmp bin ult %sort13_a64, %sort13_b64 : i64
    %sort13_equal = comb.icmp bin eq %sort12_credita, %sort03_creditb : i32
    %sort03_idb = comb.mux bin %sort03_swap, %sort02_ida, %id3 : i32
    %sort13_ib64_fill = hw.constant 0 : i32
    %sort13_ib64 = comb.concat %sort13_ib64_fill, %sort03_idb : i32, i32
    %sort12_ida = comb.mux bin %sort12_swap, %sort02_idb, %sort01_idb : i32
    %sort13_ia64_fill = hw.constant 0 : i32
    %sort13_ia64 = comb.concat %sort13_ia64_fill, %sort12_ida : i32, i32
    %sort13_id_less = comb.icmp bin ult %sort13_ib64, %sort13_ia64 : i64
    %sort13_tie = comb.and bin %sort13_equal, %sort13_id_less : i1
    %sort13_prefer = comb.or bin %sort13_greater, %sort13_tie : i1
    %sort13_same_prefer = comb.and bin %sort13_same_owner, %sort13_prefer : i1
    %sort13_b_not_owner = comb.xor bin %sort03_ownerb, %one1 : i1
    %sort13_owner_last = comb.and bin %sort12_ownera, %sort13_b_not_owner : i1
    %sort13_swap = comb.or bin %sort13_same_prefer, %sort13_owner_last : i1
    %sort13_ida = comb.mux bin %sort13_swap, %sort03_idb, %sort12_ida : i32
    %legacy1 = comb.mux bin %force_tdm, %id2, %id1 : i32
    %selected1 = comb.mux bin %fairness_enabled, %sort13_ida, %legacy1 : i32
    %sort12_ownerb = comb.mux bin %sort12_swap, %sort01_ownerb, %sort02_ownerb : i1
    %sort13_ownerb = comb.mux bin %sort13_swap, %sort12_ownera, %sort03_ownerb : i1
    %sort23_same_owner = comb.icmp bin eq %sort12_ownerb, %sort13_ownerb : i1
    %sort12_creditb = comb.mux bin %sort12_swap, %sort01_creditb, %sort02_creditb : i32
    %sort23_ax = comb.xor bin %sort12_creditb, %sign_flip : i32
    %sort23_a64_fill = hw.constant 0 : i32
    %sort23_a64 = comb.concat %sort23_a64_fill, %sort23_ax : i32, i32
    %sort13_creditb = comb.mux bin %sort13_swap, %sort12_credita, %sort03_creditb : i32
    %sort23_bx = comb.xor bin %sort13_creditb, %sign_flip : i32
    %sort23_b64_fill = hw.constant 0 : i32
    %sort23_b64 = comb.concat %sort23_b64_fill, %sort23_bx : i32, i32
    %sort23_greater = comb.icmp bin ult %sort23_a64, %sort23_b64 : i64
    %sort23_equal = comb.icmp bin eq %sort12_creditb, %sort13_creditb : i32
    %sort13_idb = comb.mux bin %sort13_swap, %sort12_ida, %sort03_idb : i32
    %sort23_ib64_fill = hw.constant 0 : i32
    %sort23_ib64 = comb.concat %sort23_ib64_fill, %sort13_idb : i32, i32
    %sort12_idb = comb.mux bin %sort12_swap, %sort01_idb, %sort02_idb : i32
    %sort23_ia64_fill = hw.constant 0 : i32
    %sort23_ia64 = comb.concat %sort23_ia64_fill, %sort12_idb : i32, i32
    %sort23_id_less = comb.icmp bin ult %sort23_ib64, %sort23_ia64 : i64
    %sort23_tie = comb.and bin %sort23_equal, %sort23_id_less : i1
    %sort23_prefer = comb.or bin %sort23_greater, %sort23_tie : i1
    %sort23_same_prefer = comb.and bin %sort23_same_owner, %sort23_prefer : i1
    %sort23_b_not_owner = comb.xor bin %sort13_ownerb, %one1 : i1
    %sort23_owner_last = comb.and bin %sort12_ownerb, %sort23_b_not_owner : i1
    %sort23_swap = comb.or bin %sort23_same_prefer, %sort23_owner_last : i1
    %sort23_ida = comb.mux bin %sort23_swap, %sort13_idb, %sort12_idb : i32
    %legacy2 = comb.mux bin %force_tdm, %id3, %id2 : i32
    %selected2 = comb.mux bin %fairness_enabled, %sort23_ida, %legacy2 : i32
    %owner01 = comb.or bin %owner0, %owner1 : i1
    %owner23 = comb.or bin %owner2, %owner3 : i1
    %owner_found = comb.or bin %owner01, %owner23 : i1
    %sort23_idb = comb.mux bin %sort23_swap, %sort12_idb, %sort13_idb : i32
    %last_rank = comb.mux bin %owner_found, %unwritten_tail, %sort23_idb : i32
    %legacy3 = comb.mux bin %force_tdm, %id0, %id3 : i32
    %selected3 = comb.mux bin %fairness_enabled, %last_rank, %legacy3 : i32
    hw.output %selected0, %selected1, %selected2, %selected3 : i32, i32, i32, i32
  }
}
